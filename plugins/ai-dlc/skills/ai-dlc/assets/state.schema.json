{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI-DLC state.json — 生命周期的充分统计量（SKILL.state 式：只留状态，不留历史）",
  "description": "脚本（scripts/aidlc_state.py）拥有它：迁移经校验后合并，引擎只提议。历史不在这里——历史在 ledger.md（只增不删）。",
  "type": "object",
  "required": [
    "version",
    "slug",
    "title",
    "track",
    "stage",
    "created_at",
    "updated_at",
    "counters",
    "gates",
    "artifacts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "title": {
      "type": "string"
    },
    "track": {
      "enum": [
        "psl",
        "task",
        "unset"
      ]
    },
    "stage": {
      "enum": [
        "intake",
        "track",
        "issue",
        "branch",
        "contract",
        "g2",
        "cards",
        "implement",
        "acceptance",
        "pr",
        "review",
        "g3",
        "merge",
        "release",
        "archive"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "issue": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "feature",
            "bug",
            "escape"
          ]
        }
      }
    },
    "branch": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "base": {
          "type": "string"
        }
      }
    },
    "contract": {
      "type": "object",
      "properties": {
        "done_when": {
          "type": "string"
        },
        "contract_yaml": {
          "type": "string"
        },
        "source": {
          "enum": [
            "acceptance-spec",
            "donewhen-extract",
            "issue-inline",
            "manual"
          ]
        },
        "compile_manifest": {
          "type": "string"
        },
        "calibration_report": {
          "type": "string"
        },
        "tests_manifest": {
          "type": "string"
        },
        "red_baseline": {
          "type": "string",
          "description": "capture_red_baseline.py 的产物；advance implement 用 --verify 核它（干净检出证据）——判据先于代码的机械形"
        }
      }
    },
    "lock": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "signed_by": {
          "type": "string"
        },
        "signed_at": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "g2",
            "l5"
          ]
        }
      }
    },
    "cards": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        },
        "lint_passed": {
          "type": "boolean",
          "description": "由 advance implement 写（它自己跑 lint_cards.py）；不在 SETTABLE 里——一个引擎 set 的布尔是执行者的说法，不是状态"
        },
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "todo",
                  "doing",
                  "done",
                  "blocked",
                  "skipped"
                ]
              },
              "retries": {
                "type": "integer"
              },
              "last_fingerprint": {
                "type": "string"
              },
              "commits": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "skip_reason": {
                "type": "string",
                "description": "`--status skipped` 必填。跳过把代价推给依赖它的卡，没有理由就无法在复盘时被追回"
              }
            }
          }
        },
        "lint_at": {
          "type": "string",
          "description": "advance implement 自己跑 lint_cards.py 通过的时刻；lint_passed 不再可 set，它是这次运行的记录不是凭证"
        }
      }
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "evaluation_result": {
          "type": "string"
        },
        "meets_done_when": {
          "type": "boolean",
          "description": "只由 `acceptance --meets <report>` 写：report 是 acceptance-fleet/scripts/meets_done_when.py 比对 behavior.thresholds 的产物（不变量 7 / R010）；不在 SETTABLE 里"
        },
        "skipped_reason": {
          "type": "string"
        },
        "skipped_by": {
          "type": "string",
          "description": "谁跳过的整体验收。`size_tier` = 体量网格（有 size_exemption 账本行与理由）"
        },
        "meets_done_when_verdict": {
          "enum": [
            "met",
            "not_met",
            "unevaluated"
          ],
          "description": "meets_done_when.py 的 verdict；unevaluated 不是通过"
        },
        "meets_done_when_report": {
          "type": "string",
          "description": "那份报告的路径；其 done_when_sha256 必须等于当前契约的哈希"
        },
        "red_green": {
          "type": "string",
          "description": "verify_red_green.py 的报告；advance pr 读它的 verdict（green = 基线里每条红测试都过了、一条没失踪）"
        }
      }
    },
    "pr": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "size_class": {
          "enum": [
            "XS",
            "S",
            "M",
            "L",
            "XL"
          ]
        },
        "pre_review_rounds": {
          "type": "integer",
          "description": "/pr --pre-review 建 PR 前的自审轮数（≤ 2）"
        },
        "pre_review_findings": {
          "type": "string",
          "description": "/pr --pre-review 的发现文件（pre-review/round-N.findings.yaml）。整体验收被网格跳过（acceptance.skipped_by=size_tier）的 Run，进 G3 / 合入前必须有它——S 档 skip 的 why 里「仍要过 /pr-review」由此从声明变成闸"
        }
      }
    },
    "review": {
      "type": "object",
      "description": "评审环的出口。done 是封闭枚举而不是布尔+散文：true（旧文件，等价 done）/ \"done\" 通过 / \"waived\" 豁免退出；waived 与任何 exit_reason 都必须带 waiver_ref 指向账本事件 id（I-83）",
      "properties": {
        "done": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "enum": [
                "done",
                "waived"
              ]
            }
          ]
        },
        "exit_reason": {
          "type": "string",
          "description": "散文限定语；出现即须有 waiver_ref，否则「这是豁免不是通过」躲在没人解析的文本里"
        },
        "waiver_ref": {
          "type": "string",
          "pattern": "^ev-\\d{4,}$",
          "description": "trace.jsonl 里那条 waiver 事件的 id（`waive` 会打印）"
        },
        "rounds": {
          "type": "integer"
        }
      }
    },
    "merge": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string"
        },
        "merged_at": {
          "type": "string"
        }
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "g1": {
          "$ref": "#/$defs/gate"
        },
        "g2": {
          "$ref": "#/$defs/gate"
        },
        "g3": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "counters": {
      "type": "object",
      "description": "分层计数：卡 / 方案 / 任务 / 本体 / 世界。世界层不设自动上限。v2 加指纹历史与 score 序列（收敛检测）。",
      "properties": {
        "card": {
          "type": "integer"
        },
        "plan": {
          "type": "integer"
        },
        "task": {
          "type": "integer"
        },
        "ontology": {
          "type": "integer"
        },
        "world": {
          "type": "integer"
        },
        "last_fingerprints": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fingerprint_repeats": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "fingerprint_history": {
          "type": "object",
          "description": "每个 key（<card|layer>:<layer>）最近 N 次指纹（N = routing.fingerprint_history）；oscillation 检测的窗口",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "scores": {
          "type": "object",
          "description": "`fail --score` 的历史：best / stale / history；plateau = stale ≥ routing.plateau_rounds",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "history": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "best": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "stale": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "waivers": {
      "type": "array",
      "description": "被豁免的东西：`advance --force` 的越级，或 `waive` 记下的、不伴随任何迁移的豁免（I-67）",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "reason",
          "at"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "signal": {
            "type": "string",
            "description": "被豁免的信号（`waive --signal`）；越级豁免没有信号，改看 unmet"
          },
          "layer": {
            "type": "string"
          },
          "card": {
            "type": "string"
          },
          "fingerprint": {
            "type": "string",
            "description": "被豁免的那次 fail 的指纹——把豁免和它免掉的失败绑在一起"
          },
          "signer": {
            "type": "string"
          },
          "signer_kind": {
            "enum": [
              "human",
              "delegated_agent"
            ]
          },
          "authorization": {
            "type": "string",
            "description": "代签授权：谁 / 何时 / 允许到哪一步"
          },
          "scope": {
            "type": "string"
          },
          "unmet": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "req": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "signed_by": {
            "type": "string"
          },
          "verify_at": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "verified",
              "accepted_risk"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "world": {
      "type": "object",
      "description": "PSL 轨的上半段产物（U1/U2/U3）+ X1 仓库级制品的**发现结果**（dos / agent_map / invariants：由 init 经 scripts/repo_assets.py 在项目目录里发现并写入，不是手 set 的；它们进 git、全组共用一份，不放 .aidlc/）",
      "properties": {
        "psl": {
          "type": "string"
        },
        "derived_dir": {
          "type": "string"
        },
        "form_draft_sha256": {
          "type": "string",
          "description": "gate g1 --verdict pass 时由脚本从 derived/form-draft.md 算出并写入；--record 里若写了别的哈希则拒签"
        },
        "dos": {
          "type": "string",
          "description": "dos.yaml 的仓库根相对路径（发现来的；`aidlc_state.py repo` 报它进没进 git）"
        },
        "invariants": {
          "type": "string",
          "description": "invariants/ 的仓库根相对路径（发现来的）"
        },
        "agent_map": {
          "type": "string",
          "description": "仓库地图（agent-map.md）的仓库根相对路径；slice_agent_map.py 按卡切片进 card_context.md"
        }
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "done": {
          "type": "boolean"
        },
        "skipped_reason": {
          "type": "string"
        }
      }
    },
    "pending": {
      "type": "object",
      "description": "未收拾的事：fail 升级后 pending.failure_report=true，`report --path` 清；check-clean / Stop hook 模板据此拒绝结束 session",
      "properties": {
        "failure_report": {
          "type": "boolean"
        }
      }
    },
    "intake": {
      "type": "object",
      "description": "体量分档：广度旋钮的输入与它换来的东西。极性不可反转——缺省 M，跳过要用证据换",
      "properties": {
        "size": {
          "enum": [
            "S",
            "M",
            "L"
          ]
        },
        "size_source": {
          "enum": [
            "default",
            "manual",
            "derived",
            "derived_early"
          ],
          "description": "只有 derived / derived_early 能拿到该档的 skip。default（缺省）与 manual（手设）一个阶段也跳不掉——一个靠遗漏或手写就能打开的门不是门。derived_early 是还没有 diff 时定的档：S 的唯一入口需要 files，所以它在结构上够不到 S"
        },
        "size_evidence": {
          "type": "object",
          "description": "定档用的四个可数量、每个量的来路、命中的规则 id"
        },
        "skips_frozen": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "飞行中重定档时被拒绝的 skip：那些阶段已经走过了。一次已经付过的 G2 不会因为重定档被追认为「其实不用签」"
        }
      }
    },
    "autonomy": {
      "type": "object",
      "description": "自治阶梯：整个流程只问一次，答案记进 state，--resume 之后仍然有效。三档都不改门——G1/G2/G3 永远要人签（不变量 6），失败永远中断",
      "properties": {
        "level": {
          "enum": [
            "ask_each",
            "auto_until_gate",
            "auto_until_failure"
          ]
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string"
        }
      }
    },
    "notes": {
      "type": "object",
      "description": "解释日记（notes.md）的索引。日记本身只增不删；晋升状态记在这里，所以晋升不用回头改写日记的任何一行",
      "properties": {
        "promoted": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "已晋升成项目规则的 note id。Open questions 不在此列——它们不晋升"
        }
      }
    },
    "learnings": {
      "type": "object",
      "description": "本次运行**启动时**编译进来的项目规则（init 写，之后不动）。跑动中晋升的规则不影响本轮——你前面批准过的门对应的是当时那套规则集合，框架不在跑动中抽掉地基（同不变量 13）",
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "rules": {
          "type": "integer"
        },
        "compiled_at": {
          "type": "string"
        }
      }
    },
    "escapes": {
      "type": "array",
      "description": "R12 逃逸缺陷：`escape` 子命令登记；每条已由人归因到层并计入 counters.<layer>；同一行追加在 escape-defects.md 并镜像进归档",
      "items": {
        "type": "object",
        "required": [
          "at",
          "layer",
          "why_gate_missed",
          "by"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "feature": {
            "type": "string"
          },
          "pr": {},
          "symptom": {
            "type": "string"
          },
          "found_via": {
            "type": "string"
          },
          "layer": {
            "enum": [
              "card",
              "plan",
              "task",
              "ontology",
              "world"
            ]
          },
          "why_gate_missed": {
            "type": "string"
          },
          "issue": {},
          "by": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "verdict": {
          "enum": [
            "pending",
            "pass",
            "reject",
            "waived"
          ]
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "record": {
          "type": "string"
        },
        "attribution": {
          "enum": [
            "derivation_error",
            "rule_error",
            "none"
          ]
        },
        "signer_kind": {
          "enum": [
            "human",
            "delegated_agent"
          ],
          "description": "human 亲签，或用户明确授权下的代签 agent（须有 authorization）"
        },
        "authorization": {
          "type": "string",
          "description": "代签授权：谁 / 何时 / 允许到哪一步"
        }
      }
    }
  }
}\n