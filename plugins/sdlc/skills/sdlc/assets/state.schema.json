{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sdlc state.json — 生命周期的充分统计量（SKILL.state 式：只留状态，不留历史）",
  "description": "脚本（scripts/sdlc_state.py）拥有它：迁移经校验后合并，引擎只提议。历史不在这里——历史在 ledger.md（只增不删）。",
  "type": "object",
  "required": [
    "version",
    "slug",
    "title",
    "track",
    "stage",
    "created_at",
    "updated_at",
    "counters",
    "gates",
    "artifacts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "title": {
      "type": "string"
    },
    "track": {
      "enum": [
        "psl",
        "task",
        "unset"
      ]
    },
    "stage": {
      "enum": [
        "intake",
        "track",
        "issue",
        "branch",
        "contract",
        "g2",
        "cards",
        "implement",
        "acceptance",
        "pr",
        "review",
        "g3",
        "merge",
        "release",
        "archive"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "issue": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "feature",
            "bug",
            "escape"
          ]
        }
      }
    },
    "branch": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "base": {
          "type": "string"
        }
      }
    },
    "contract": {
      "type": "object",
      "properties": {
        "done_when": {
          "type": "string"
        },
        "contract_yaml": {
          "type": "string"
        },
        "source": {
          "enum": [
            "acceptance-spec",
            "donewhen-extract",
            "issue-inline",
            "manual"
          ]
        },
        "compile_manifest": {
          "type": "string"
        },
        "calibration_report": {
          "type": "string"
        },
        "tests_manifest": {
          "type": "string"
        }
      }
    },
    "lock": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "signed_by": {
          "type": "string"
        },
        "signed_at": {
          "type": "string"
        },
        "stage": {
          "enum": [
            "g2",
            "l5"
          ]
        }
      }
    },
    "cards": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string"
        },
        "lint_passed": {
          "type": "boolean"
        },
        "items": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "todo",
                  "doing",
                  "done",
                  "blocked"
                ]
              },
              "retries": {
                "type": "integer"
              },
              "last_fingerprint": {
                "type": "string"
              },
              "commits": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "acceptance": {
      "type": "object",
      "properties": {
        "evaluation_result": {
          "type": "string"
        },
        "meets_done_when": {
          "type": "boolean"
        },
        "skipped_reason": {
          "type": "string"
        }
      }
    },
    "pr": {
      "type": "object",
      "properties": {
        "number": {
          "type": "integer"
        },
        "url": {
          "type": "string"
        },
        "size_class": {
          "enum": [
            "XS",
            "S",
            "M",
            "L",
            "XL"
          ]
        },
        "pre_review_rounds": {
          "type": "integer",
          "description": "/pr --pre-review 建 PR 前的自审轮数（≤ 2）"
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "done": {
          "type": "boolean"
        },
        "exit_reason": {
          "type": "string"
        },
        "rounds": {
          "type": "integer"
        }
      }
    },
    "merge": {
      "type": "object",
      "properties": {
        "sha": {
          "type": "string"
        },
        "merged_at": {
          "type": "string"
        }
      }
    },
    "gates": {
      "type": "object",
      "properties": {
        "g1": {
          "$ref": "#/$defs/gate"
        },
        "g2": {
          "$ref": "#/$defs/gate"
        },
        "g3": {
          "$ref": "#/$defs/gate"
        }
      }
    },
    "counters": {
      "type": "object",
      "description": "分层计数：卡 / 方案 / 任务 / 本体 / 世界。世界层不设自动上限。v2 加指纹历史与 score 序列（收敛检测）。",
      "properties": {
        "card": {
          "type": "integer"
        },
        "plan": {
          "type": "integer"
        },
        "task": {
          "type": "integer"
        },
        "ontology": {
          "type": "integer"
        },
        "world": {
          "type": "integer"
        },
        "last_fingerprints": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "fingerprint_repeats": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "fingerprint_history": {
          "type": "object",
          "description": "每个 key（<card|layer>:<layer>）最近 N 次指纹（N = routing.fingerprint_history）；oscillation 检测的窗口",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "scores": {
          "type": "object",
          "description": "`fail --score` 的历史：best / stale / history；plateau = stale ≥ routing.plateau_rounds",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "history": {
                "type": "array",
                "items": {
                  "type": "number"
                }
              },
              "best": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "stale": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "reason",
          "at"
        ],
        "properties": {
          "stage": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "at": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "req": {
            "type": "string"
          },
          "risk": {
            "type": "string"
          },
          "signed_by": {
            "type": "string"
          },
          "verify_at": {
            "type": "string"
          },
          "status": {
            "enum": [
              "open",
              "verified",
              "accepted_risk"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "world": {
      "type": "object",
      "description": "PSL 轨的上半段产物（U1/U2/U3/X1）",
      "properties": {
        "psl": {
          "type": "string"
        },
        "derived_dir": {
          "type": "string"
        },
        "form_draft_sha256": {
          "type": "string"
        },
        "dos": {
          "type": "string"
        },
        "invariants": {
          "type": "string"
        }
      }
    },
    "release": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "done": {
          "type": "boolean"
        },
        "skipped_reason": {
          "type": "string"
        }
      }
    },
    "pending": {
      "type": "object",
      "description": "未收拾的事：fail 升级后 pending.failure_report=true，`report --path` 清；check-clean / Stop hook 模板据此拒绝结束 session",
      "properties": {
        "failure_report": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "verdict": {
          "enum": [
            "pending",
            "pass",
            "reject",
            "waived"
          ]
        },
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "record": {
          "type": "string"
        },
        "attribution": {
          "enum": [
            "derivation_error",
            "rule_error",
            "none"
          ]
        }
      }
    }
  }
}
